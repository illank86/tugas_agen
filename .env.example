# Salin berkas ini menjadi `.env` lalu isi kuncinya:
#   PowerShell : Copy-Item .env.example .env
#   Bash       : cp .env.example .env
# Berkas `.env` sudah ada di .gitignore, jadi kunci tidak ikut ter-commit.
# Variabel lingkungan yang disetel di terminal selalu menang atas isi `.env`.

# Wajib untuk mengaktifkan LLM (parsing CV, parsing job description, narasi).
# Buat kunci di https://platform.deepseek.com -> API Keys
DEEPSEEK_API_KEY=

# Opsional
DEEPSEEK_MODEL=deepseek-chat
# DEEPSEEK_BASE_URL=https://api.deepseek.com
